{
  "name": "@str-ventures/react-slides",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "A markdown-driven presentation tool for creating interactive slide decks",
  "repository": {
    "type": "git",
    "url": "https://github.com/STR-Ventures/react-slides.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "main": "dist/react-slides.umd.cjs",
  "module": "dist/react-slides.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/react-slides.js",
      "require": "./dist/react-slides.umd.cjs"
    }
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "html2canvas": "^1.4.1",
    "js-yaml": "^4.1.0",
    "jspdf": "^3.0.1",
    "katex": "^0.16.27",
    "lucide-react": "^0.263.1",
    "pptxgenjs": "^4.0.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-markdown": "^8.0.7",
    "recharts": "^2.15.3",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^3.0.1",
    "remark-math": "^6.0.0",
    "tree": "^0.1.3"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:lib": "tsc && vite build --config vite.config.lib.ts",
    "build:demo": "tsc && vite build --config vite.config.demo.ts",
    "preview": "vite preview",
    "cloudflare-build": "npm install @rollup/rollup-linux-x64-gnu && tsc && vite build",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@types/html2canvas": "^1.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/katex": "^0.16.7",
    "@types/node": "^20.17.49",
    "@types/react": "^18.3.21",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.8.3",
    "vite": "^6.0.0"
  }
}
