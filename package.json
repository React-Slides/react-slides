{
  "name": "@react-slides/react-slides",
  "version": "2.0.0",
  "type": "module",
  "license": "MIT WITH Commons-Clause",
  "description": "A markdown-driven presentation tool for creating interactive slide decks",
  "keywords": [
    "react",
    "slides",
    "presentation",
    "markdown",
    "slideshow",
    "slide-deck",
    "charts",
    "recharts",
    "animations",
    "katex",
    "math",
    "pdf-export",
    "pptx-export"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/React-Slides/react-slides.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "dist/react-slides.js",
  "module": "dist/react-slides.js",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "import": "./dist/react-slides.js",
      "types": "./dist/index.d.ts"
    },
    "./styles.css": "./dist/react-slides.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/bump-build.js && tsc && vite build",
    "build:lib": "node scripts/bump-build.js && tsc && vite build --config vite.config.lib.ts",
    "build:demo": "node scripts/bump-build.js && tsc && vite build --config vite.config.demo.ts",
    "preview": "vite preview",
    "cloudflare-build": "npm install @rollup/rollup-linux-x64-gnu && tsc && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.0.0",
      "onFail": "error"
    }
  },
  "peerDependencies": {
    "html2canvas": "^1.4.1",
    "js-yaml": "^4.3.2",
    "jspdf": "^4.2.1",
    "katex": "^0.16.0",
    "lucide-react": "^0.200.0 || ^0.300.0 || ^0.400.0",
    "pptxgenjs": "^3.0.0 || ^4.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-markdown": "^8.0.0 || ^9.0.0",
    "recharts": "^2.0.0",
    "rehype-katex": "^6.0.0 || ^7.0.0",
    "remark-gfm": "^3.0.0 || ^4.0.0",
    "remark-math": "^5.0.0 || ^6.0.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/katex": "^0.16.7",
    "@types/node": "^20.17.49",
    "@types/react": "^18.3.21",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^4.0.16",
    "autoprefixer": "^10.4.16",
    "html2canvas": "^1.4.1",
    "js-yaml": "^4.3.2",
    "jsdom": "^27.4.0",
    "jspdf": "^4.2.1",
    "katex": "^0.16.27",
    "lucide-react": "^0.263.1",
    "postcss": "^8.4.32",
    "pptxgenjs": "^4.0.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-markdown": "^8.0.7",
    "recharts": "^2.15.3",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^3.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.8.3",
    "vite": "^6.0.0",
    "vitest": "^4.0.16"
  }
}
